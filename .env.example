# Documentation only. Python does NOT automatically load this file.
# Set this in your shell or hosting provider's secret environment settings.
WOS_API_KEY=
# Optional: raises the OpenAlex daily request budget. Never passed in tool arguments.
OPENALEX_API_KEY=

# Defaults shown. Use literature to start without a Clarivate key.
WOS_MCP_PROFILE=full
WOS_MCP_MIN_INTERVAL_SECONDS=1.1
WOS_MCP_CACHE_TTL_SECONDS=900
WOS_MCP_OPERATION_TIMEOUT_SECONDS=30

# Required only with the self-hosted HTTP entrypoint.
# WOS_MCP_HTTP_ORIGIN=https://mcp.example.com
# WOS_MCP_AUTH_ISSUER=https://identity.example.com/oauth
# WOS_MCP_AUTH_JWKS_URI=https://identity.example.com/oauth/jwks
